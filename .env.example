WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
POSTGRES_DB=ticket_overlord
POSTGRES_USER=ticket_overlord
POSTGRES_PASSWORD=ticket_overlord
POSTGRES_TEST_PORT=5433
REDIS_PORT=6379
REDIS_TEST_PORT=6380
REDIS_URL=redis://localhost:6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# API integrations
APP_ENV=local

# Local evaluation data. Production requires an explicit, secret DEMO_PASSWORD
# and ALLOW_PRODUCTION_DEMO_SEED=true only for the authorized one-off seed.
SEED_EVENT_COUNT=9000
DEMO_PASSWORD=TicketOverlord2026!
ALLOW_PRODUCTION_DEMO_SEED=false

# Zero-config local default: confirmation and recovery links are printed by the API.
# To send real emails, use `resend`, create your own API key and verify the sender domain.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Forks must replace this address with one from their own verified Resend domain.
RESEND_FROM_EMAIL=Ticket Overlord <ingressos@israeldeveloper.com.br>
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# External catalog used only when an organizer searches or creates an event.
TMDB_READ_ACCESS_TOKEN=

# Local S3-compatible storage. Railway Bucket production uses its private and
# public S3-compatible endpoints plus the bucket credentials supplied by Railway.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ticket-overlord-events
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ticket_overlord
S3_SECRET_ACCESS_KEY=ticket_overlord_secret
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL_SECONDS=900
