WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
POSTGRES_DB=ticket_overlord
POSTGRES_USER=ticket_overlord
POSTGRES_PASSWORD=ticket_overlord
POSTGRES_TEST_PORT=5433

# API integrations
APP_ENV=local

# Zero-config local default: confirmation and recovery links are printed by the API.
# To send real emails, use `resend`, create your own API key and verify the sender domain.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Forks must replace this address with one from their own verified Resend domain.
RESEND_FROM_EMAIL=Ticket Overlord <ingressos@israeldeveloper.com.br>
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
